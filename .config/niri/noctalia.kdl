layout {

    focus-ring {
        active-color   "#8b8dc1"
        inactive-color "#1a1a23"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#8b8dc1"
        inactive-color "#1a1a23"
        urgent-color   "#fd4663"
    }

    shadow {
        color "#1a1a2370"
    }

    tab-indicator {
        active-color   "#8b8dc1"
        inactive-color "#2f326a"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#8b8dc180"
    }
}

recent-windows {
    highlight {
        active-color "#8b8dc1"
        urgent-color "#fd4663"
    }
}
