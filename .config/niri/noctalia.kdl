layout {

    focus-ring {
        active-color   "#e4b467"
        inactive-color "#282116"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#e4b467"
        inactive-color "#282116"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#e4b467"
        inactive-color "#855914"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#e4b46780"
    }
}

recent-windows {
    highlight {
        active-color "#e4b467"
        urgent-color "#fd4663"
    }
}
